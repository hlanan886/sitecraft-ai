{
  "name": "ai-site-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate:drafts": "node --experimental-strip-types scripts/migrate-file-drafts.ts",
    "test:three-sites": "node scripts/generate-three-ai-sites.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
