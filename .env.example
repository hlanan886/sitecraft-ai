NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=sites.localhost
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_MODEL=deepseek-v4-flash
# 推理开关。留空 = 按调用点自动决定（大批量生成关、意图理解开）。
# 实测（2026-09-10）：关推理后 16000→2942 tokens、耗时 62s→9.2s、且只有关掉才会遵守格式契约。
# 设 1 = 全局关；设 0 = 全局开（排查/对比用）。
SITECRAFT_DISABLE_REASONING=
DEEPSEEK_MAX_TOKENS=8000
# 可选第二 provider：GPT（OpenAI 兼容）。SITECRAFT_AI_PROVIDER=gpt 时生效；
# 默认 api.openai.com，测试可用中转站 base_url（如 https://gpt.example.com/v1）。
# SITECRAFT_AI_PROVIDER=deepseek
# GPT_BASE_URL=https://api.openai.com/v1
# GPT_API_KEY=replace-me
# GPT_MODEL=gpt-4o
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/site_studio
SITE_STORE=postgres
DATABASE_POOL_SIZE=10
DATABASE_SSL=false
DEFAULT_WORKSPACE_ID=demo
# 功能开关：逗号分隔，只接受下列名称；默认全部关闭。
# SITECRAFT_FEATURE_FLAGS=template_matching_v2,quality_gate_v1,chat_cas_v1,release_v1,access_scope_v1
# 单项覆盖优先于列表，可用 true/false（false 可作为紧急熔断）。
# SITECRAFT_FLAG_QUALITY_GATE_V1=false
# Canary：仅列出的 workspace 额外启用指定开关，不影响其他 workspace。
# SITECRAFT_CANARY_WORKSPACES=canary-internal
# SITECRAFT_CANARY_FLAGS=template_matching_v2,quality_gate_v1
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret
SMTP_HOST=localhost
SMTP_PORT=1025
